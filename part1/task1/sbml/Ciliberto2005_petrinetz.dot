digraph Ciliberto2005 {
graph [rankdir=LR, bgcolor="white", fontname="Helvetica", fontsize=12, labelloc=b, label="Ciliberto2005 · p53/Mdm2 · Petrinetz\nDurchgezogen: SBML-Reaktionen (Gewicht 1); gestrichelt: Einfluss auf Reaktionsrate (+/−).\nDoppelrand: durch Regel bestimmt, keine unabhängige Stoffmenge; Startwerte laut SBML (mol/L).\np53 = p53_total − p53_ub − p53_ub_ub; MDM2_total = Mdm2_cyt + Mdm2_p_cyt + Mdm2_p_nuc/15.\nIR = ampl × step; step: 1 nach Trigger t > 10 plus 2 s Verzögerung, 0 bei t > 20.\nDNA_damage erhöht kd2_0 und damit R18. Transporte bleiben getrennte Ein-/Ausflüsse wie im SBML.", nodesep=0.22, ranksep=0.55];
node [fontname="Helvetica", fontsize=12, style=filled];
edge [fontname="Helvetica", fontsize=10, color="#475569", arrowsize=0.65];
subgraph cluster_Cyt {
label="Cytoplasma"; color="#94a3b8"; style=rounded;
"Mdm2_cyt" [shape=circle, fillcolor="#dbeafe", peripheries=1, label="Mdm2\ncyt\n0.1161"];
"Mdm2_p_cyt" [shape=circle, fillcolor="#dbeafe", peripheries=1, label="Mdm2\np\ncyt\n0.01187"];
"MDM2_total" [shape=circle, fillcolor="#dbeafe", peripheries=2, label="MDM2\ntotal\n0.15009"];
}
subgraph cluster_Nuc {
label="Zellkern"; color="#94a3b8"; style=rounded;
"DNA_damage" [shape=circle, fillcolor="#ede9fe", peripheries=1, label="DNA\ndamage\n0"];
"IR" [shape=circle, fillcolor="#ede9fe", peripheries=2, label="IR\n0"];
"p53_total" [shape=circle, fillcolor="#ede9fe", peripheries=1, label="p53\ntotal\n0.07118"];
"p53_ub" [shape=circle, fillcolor="#ede9fe", peripheries=1, label="p53\nub\n0.02456"];
"p53_ub_ub" [shape=circle, fillcolor="#ede9fe", peripheries=1, label="p53\nub\nub\n0.006826"];
"Mdm2_p_nuc" [shape=circle, fillcolor="#ede9fe", peripheries=1, label="Mdm2\np\nnuc\n0.3318"];
"p53" [shape=circle, fillcolor="#ede9fe", peripheries=2, label="p53\n0.039794"];
}
"DNA_Damage" [shape=box, fillcolor="#f1f5f9", label="R1\nDNA Damage"];
