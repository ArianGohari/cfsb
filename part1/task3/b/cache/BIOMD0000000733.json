{
  "name" : "Moore_2004_Mathematical model for CML and T cell interaction",
  "description" : "Its a mathematical model depicting CML (chronic myelogenous leukemia) interaction with T cells and impact of T cell activations on CML progression over time.",
  "format" : {
    "name" : "SBML",
