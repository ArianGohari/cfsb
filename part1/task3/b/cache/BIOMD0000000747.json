{
  "name" : "Nagashima2002 - Simulating blood coagulation inhibitory effects",
  "description" : "Mathematical model of blood coagulation and the effects of inhibitors of Xa, Va:Xa and IIa.",
  "format" : {
    "name" : "SBML",
