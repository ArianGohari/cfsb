{
  "name" : "Benary2019 - Controlling NFKB dynamics by B-TrCP",
  "description" : "<notes xmlns=\"http://www.sbml.org/sbml/level2/version4\">      <body xmlns=\"http://www.w3.org/1999/xhtml\">        <pre>its a mathematical model studying impact of b_TrCP on NFKB nuclear dynamics. This model is derived from Lipniacki2004 (PMID:15094015).</pre>      </body>    </notes>",
  "format" : {
    "name" : "SBML",
