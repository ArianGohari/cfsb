{
  "name" : "Carbo2013 - Mucosal Immune Response during H.pylori Infection",
  "description" : "<notes xmlns=\"http://www.sbml.org/sbml/level2/version4\">      <body xmlns=\"http://www.w3.org/1999/xhtml\">    </body>          </notes>",
  "format" : {
