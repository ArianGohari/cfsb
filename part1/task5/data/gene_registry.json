{"header":{"type":"esummary","version":"0.3"},"result":{"uids":["19","3553","7124","54209","929","2214","7097","3576","3383"],"19":{"uid":"19","name":"ABCA1","description":"ATP binding cassette subfamily A member 1","status":"","currentid":"","chromosome":"9","geneticsource":"genomic","maplocation":"9q31.1","otheraliases":"ABC-1, ABC1, CERP, HDLCQTL13, HDLDT1, HPALP1, TGD","otherdesignations":"phospholipid-transporting ATPase ABCA1|ATP-binding cassette sub-family A member 1|ATP-binding cassette transporter A1|ATP-binding cassette, sub-family A (ABC1), member 1|cholesterol efflux regulatory protein|membrane-bound","nomenclaturesymbol":"ABCA1","nomenclaturename":"ATP binding cassette subfamily A member 1","nomenclaturestatus":"Official","mim":["600046"],"genomicinfo":[{"chrloc":"9","chraccver":"NC_000009.12","chrstart":104928154,"chrstop":104781005,"exoncount":50}],"geneweight":82796,"summary":"The membrane-associated protein encoded by this gene is a member of the superfamily of ATP-binding cassette (ABC) transporters. ABC proteins transport various molecules across extra- and intracellular membranes. ABC genes are divided into seven distinct subfamilies (ABC1, MDR/TAP, MRP, ALD, OABP, GCN20, White). This protein is a member of the ABC1 subfamily. Members of the ABC1 subfamily comprise the only major ABC subfamily found exclusively in multicellular eukaryotes. With cholesterol as its substrate, this protein functions as a cholesteral efflux pump in the cellular lipid removal pathway. Mutations in both alleles of this gene cause Tangier disease and familial high-density lipoprotein (HDL) deficiency. [provided by RefSeq, Sep 2019]","chrsort":"09","chrstart":104781005,"organism":{"scientificname":"Homo sapiens","commonname":"human","taxid":9606},"locationhist":[{"annotationrelease":"RS_2025_08","assemblyaccver":"GCF_000001405.40","chraccver":"NC_000009.12","chrstart":104928154,"chrstop":104781005},{"annotationrelease":"RS_2025_08","assemblyaccver":"GCF_009914755.1","chr