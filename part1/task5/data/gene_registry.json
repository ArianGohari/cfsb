731},{"annotationrelease":"RS_2023_03","assemblyaccver":"GCF_009914755.1","chraccver":"NC_060929.1","chrstart":141159108,"chrstop":141157139},{"annotationrelease":"110","assemblyaccver":"GCF_000001405.40","chraccver":"NC_000005.10","chrstart":140633700,"chrstop":140631731},{"annotationrelease":"110","assemblyaccver":"GCF_009914755.1","chraccver":"NC_060929.1","chrstart":141159108,"chrstop":141157139},{"annotationrelease":"109.20211119","assemblyaccver":"GCF_000001405.39","chraccver":"NC_000005.10","chrstart":140633700,"chrstop":140631731},{"annotationrelease":"RS_2024_09","assemblyaccver":"GCF_000001405.25","chraccver":"NC_000005.9","chrstart":140013285,"chrstop":140011316},{"annotationrelease":"105.20220307","assemblyaccver":"GCF_000001405.25","chraccver":"NC_000005.9","chrstart":140013285,"chrstop":140011316},{"annotationrelease":"105","assemblyaccver":"GCF_000001405.25","chraccver":"NC_000005.9","chrstart":140013285,"chrstop":140011312},{"annotationrelease":"105","assemblyaccver":"GCF_000002125.1","chraccver":"AC_000137.1","chrstart":135158560,"chrstop":135156587},{"annotationrelease":"105","assemblyaccver":"GCF_000306695.2","chraccver":"NC_018916.2","chrstart":139446527,"chrstop":139444554}]},"2214":{"uid":"2214","name":"FCGR3A","description":"Fc gamma receptor IIIa","status":"","currentid":"","chromosome":"1","geneticsource":"genomic","maplocation":"1q23.3","otheraliases":"CD16-II, CD16A, FCG3, FCGR3, FCRIIIA, FcGRIIIA, IGFR3, IMD20","otherdesignations":"low affinity immunoglobulin gamma Fc region receptor III-A|CD16a antigen|Fc fragment of IgG receptor IIIa|Fc fragment of IgG, low affinity IIIa, receptor (CD16a)|Fc gamma receptor III-A|Fc-gamma RIII-alpha|Fc-gamma receptor IIIb (CD16)|FcgammaRIIIA|IgG Fc receptor III-A|igG Fc receptor III-2|immunoglobulin G Fc receptor III|low affinity immunoglobulin gamma receptor III-a Fc fragment|neutrophil-specific antigen NA","nomenclaturesymbol":"FCGR3A","nomenclaturename":"Fc gamma receptor IIIa","nomenclaturestatus":"Official","mim":["146740"],"genomicinfo":[{"chrloc":"1","chraccver":"NC_000001.11","chrstart":161550736,"chrstop":161541758,"exoncount":7}],"geneweight":19828,"summary":"This gene encodes a receptor for the Fc portion of immunoglobulin G, and it is involved in the removal of antigen-antibody complexes from the circulation, as well as other responses, including antibody dependent cellular mediated cytotoxicity and antibody dependent enhancement of virus infections. This gene (FCGR3A) is highly similar to another nearby gene (FCGR3B) located on chromosome 1. The receptor encoded by this gene is expressed on natural killer (NK) cells as an integral membrane glycoprotein anchored through a transmembrane peptide, whereas FCGR3B is expressed on polymorphonuclear neutrophils (PMN) where the receptor is anchored through a phosphatidylinositol (PI) linkage. Mutations in this gene are associated with immunodeficiency 20, and have been linked to susceptibility to recurrent viral infections, susceptibility to systemic lupus erythematosus, and alloimmune neonatal neutropenia. Alternatively spliced transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Aug 2020]","chrsort":"01","chrstart":161541758,"organism":{"scientificname":"Homo sapiens","commonname":"human","taxid":9606},"locationhist":[{"annotationrelease":"RS_2025_08","assemblyaccver":"GCF_000001405.40","chraccver":"NC_000001.11","chrstart":161550736,"chrstop":161541758},{"annotationrelease":"RS_2025_08","assemblyaccver":"GCF_009914755.1","chraccver":"NC_060925.1","chrstart":160813362,"chrstop":160804384},{"annotationrelease":"RS_2024_08","assemblyaccver":"GCF_000001405.40","chraccver":"NC_000001.11","chrstart":161550736,"chrstop":161541758},{"annotationrelease":"RS_2024_08","assemblyaccver":"GCF_009914755.1","chraccver":"NC_060925.1","chrstart":160813362,"chrstop":160804384},{"annotationrelease":"RS_2023_10","assemblyaccver":"GCF_000001405.40","chraccver":"NC_000001.11","chrstart":161550736,"chrstop":161541758},{"annotationrelease":"RS_2023_10","assemblyaccver":"GCF_009914755.1","chraccver":"NC_060925.1","chrstart":160813362,"chrstop":160804384},{"annotationrelease":"RS_2023_03","assemblyaccver":"GCF_000001405.40","chraccver":"NC_000001.11","chrstart":161550736,"chrstop":161541758},{"annotationrelease":"RS_2023_03","assemblyaccver":"GCF_009914755.1","chraccver":"NC_060925.1","chrstart":160813362,"chrstop":160804384},{"annotationrelease":"110","assemblyaccver":"GCF_000001405.40","chraccver":"NC_000001.11","chrstart":161550736,"chrstop":161541758},{"annotationrelease":"110","assemblyaccver":"GCF_009914755.1","chraccver":"NC_060925.1","chrstart":160813362,"chrstop":160804384},{"annotationrelease":"109.20211119","assemblyaccver":"GCF_000001405.39","chraccver":"NC_000001.11","chrstart":161550736,"chrstop":161541758},{"annotationrelease":"RS_2024_09","assemblyaccver":"GCF_000001405.25","chraccver":"NC_000001.10","chrstart":161520526,"chrstop":161511548},{"annotationrelease":"105.20220307","assemblyaccver":"GCF_000001405.25","chraccver":"NC_000001.10","chrstart":161520526,"chrstop":161511548},{"annotationrelease":"105","assemblyaccver":"GCF_000001405.25","chraccver":"NC_000001.10","chrstart":161520412,"chrstop":161511548},{"annotationrelease":"105","assemblyaccver":"GCF_000002125.1","chraccver":"AC_000133.1","chrstart":132843978,"chrstop":132836940},{"annotationrelease":"105","assemblyaccver":"GCF_000306695.2","chraccver":"NC_018912.2","chrstart":162942245,"chrstop":162933381},{"annotationrelease":"105","assemblyaccver":"GCF_000002125.1","chraccver":"NW_001840690.1","chrstart":5232,"chrstop":7446}]},"7097":{"uid":"7097","name":"TLR2","description":"toll like receptor 2","status":"","currentid":"","chromosome":"4","geneticsource":"genomic","maplocation":"4q31.3","otheraliases":"CD282, TIL4","otherdesignations":"toll-like receptor 2|toll/interleukin-1 receptor-like protein 4","nomenclaturesymbol":"TLR2","nomenclaturename":"toll like receptor 2","nomenclaturestatus":"Official","mim":["603028"],"genomicinfo":[{"chrloc":"4","chraccver":"NC_000004.12","chrstart":153684279,"chrstop":153710636,"exoncount":4}],"geneweight":144562,"summary":"The protein encoded by this gene is a member of the Toll-like receptor (TLR) family which plays a fundamental role in pathogen recognition and activation of innate immunity. TLRs are highly conserved from Drosophila to humans and share structural and functional similarities. This protein is a cell-surface protein that can form heterodimers with other TLR family members to recognize conserved molecules derived from microorganisms known as pathogen-associated molecular patterns (PAMPs). Activation of TLRs by PAMPs leads to an up-regulation of signaling pathways to modulate the host's inflammatory response. This gene is also thought to promote apoptosis in response to bacterial lipoproteins. This gene has been implicated in the pathogenesis of several autoimmune diseases. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Jan 2016]","chrsort":"04","chrstart":153684279,"organism":{"scientificname":"Homo sapiens","commonname":"human","taxid":9606},"locationhist":[{"annotationrelease":"RS_2025_08","assemblyaccver":"GCF_000001405.40","chraccver":"NC_000004.12","chrstart":153684279,"chrstop":153710636},{"annotationrelease":"RS_2025_08","assemblyaccver":"GCF_009914755.1","chraccver":"NC_060928.1","chrstart":157008776,"chrstop":157030715},{"annotationrelease":"RS_2024_08","assemblyaccver":"GCF_000001405.40","chraccver":"NC_000004.12","chrstart":153684279,"chrstop":153710636},{"annotationrelease":"RS_2024_08","assemblyaccver":"GCF_009914755.1","chraccver":"NC_060928.1","chrstart":157008776,"chrstop":157030715},{"annotationrelease":"RS_2023_10","assemblyaccver":"GCF_000001405.40","chraccver":"NC_000004.12","chrstart":153684279,"chrstop":153710636},{"annotationrelease":"RS_2023_10","assemblyaccver":"GCF_009914755.1","chraccver":"NC_060928.1","chrstart":157008776,"chrstop":157030715},{"annotationrelease":"RS_2023_03","assemblyaccver":"GCF_000001405.40","chraccver":"NC_000004.12","chrstart":153684279,"chrstop":153710636},{"annotationrelease":"RS_2023_03","assemblyaccver":"GCF_009914755.1","chraccver":"NC_060928.1","chrstart":157008776,"chrstop":157030715},{"annotationrelease":"110","assemblyaccver":"GCF_000001405.40","chraccver":"NC_000004.12","chrstart":153684279,"chrstop":153710636},{"annotationrelease":"110","assemblyaccver":"GCF_009914755.1","chraccver":"NC_060928.1","chrstart":157008776,"chrstop":157030715},{"annotationrelease":"109.20211119","assemblyaccver":"GCF_000001405.39","chraccver":"NC_000004.12","chrstart":153684079,"chrstop":153710642},{"annotationrelease":"RS_2024_09","assemblyaccver":"GCF_000001405.25","chraccver":"NC_000004.11","chrstart":154605431,"chrstop":154627411},{"annotationrelease":"105.20220307","assemblyaccver":"GCF_000001405.25","chraccver":"NC_000004.11","chrstart":154605431,"chrstop":154627411},{"annotationrelease":"105","assemblyaccver":"GCF_000001405.25","chraccver":"NC_000004.11","chrstart":154605403,"chrstop":154627242},{"annotationrelease":"105","assemblyaccver":"GCF_000002125.1","chraccver":"AC_000136.1","chrstart":150336456,"chrstop":150358267},{"annotationrelease":"105","assemblyaccver":"GCF_000306695.2","chraccver":"NC_018915.2","chrstart":154583810,"chrstop":154605613}]},"3576":{"uid":"3576","name":"CXCL8","description":"C-X-C motif chemokine ligand 8","status":"","currentid":"","chromosome":"4","geneticsource":"genomic","maplocation":"4q13.3","otheraliases":"GCP-1, GCP1, IL8, LECT, LUCT, LYNAP, MDNCF, MONAP, NAF, NAP-1, NAP1, SCYB8","otherdesignations":"interleukin-8|T-cell chemotactic factor|alveolar macrophage chemotactic factor I|beta endothelial cell-derived neutrophil activating peptide|beta-thromboglobulin-like protein|chemokine (C-X-C motif) ligand 8|emoctakin|granulocyte chemotactic protein 1|interleukin 8|lung giant cell carcinoma-derived chemotactic protein|lymphocyte derived neutrophil activating peptide|monocyte-derived neutrophil chemotactic factor|monocyte-derived neutrophil-activating peptide|neutrophil-activating peptide 1|small inducible cytokine subfamily B, member 8|tumor necrosis factor-induced gene 1","nomenclaturesymbol":"CXCL8","nomenclaturename":"C-X-C motif chemokine ligand 8","nomenclaturestatus":"Official","mim":["146930"],"genomicinfo":[{"chrloc":"4","chraccver":"NC_000004.12","chrstart":73740568,"chrstop":73743715,"exoncount":3}],"geneweight":203030,"summary":"The protein encoded by this gene is a member of the CXC chemokine family and is a major mediator of the inflammatory response. The encoded protein is commonly referred to as interleukin-8 (IL-8). IL-8 is secreted by mononuclear macrophages, neutrophils, eosinophils, T lymphocytes, epithelial cells, and fibroblasts. It functions as a chemotactic factor by guiding the neutrophils to the site of infection. Bacterial and viral products rapidly induce IL-8 expression. IL-8 also participates with other cytokines in the proinflammatory signaling cascade and plays a role in systemic inflammatory response syndrome (SIRS). This gene is believed to play a role in the pathogenesis of the lower respiratory tract infection bronchiolitis, a common respiratory tract disease caused by the respiratory syncytial virus (RSV). The overproduction of this proinflammatory protein is thought to cause the lung inflammation associated with csytic fibrosis. This proinflammatory protein is also suspected of playing a role in coronary artery disease and endothelial dysfunction. This protein is also secreted by tumor cells and promotes tumor migration, invasion, angiogenesis and metastasis. This chemokine is also a potent angiogenic factor. The binding of IL-8 to one of its receptors (IL-8RB/CXCR2) increases the permeability of blood vessels and increasing levels of IL-8 are positively correlated with increased severity of multiple disease outcomes (eg, sepsis). This gene and other members of the CXC chemokine gene family form a gene cluster in a region of chromosome 4q. [provided by RefSeq, May 2020]","chrsort":"04","chrstart":73740568,"organism":{"scientificname":"Homo sapiens","commonname":"human","taxid":9606},"locationhist":[{"annotationrelease":"RS_2025_08","assemblyaccver":"GCF_000001405.40","chraccver":"NC_000004.12","chrstart":73740568,"chrstop":73743715},{"annotationrelease":"RS_2025_08","assemblyaccver":"GCF_009914755.1","chraccver":"NC_060928.1","chrstart":77084333,"chrstop":77087479},{"annotationrelease":"RS_2024_08","assemblyaccver":"GCF_000001405.40","chraccver":"NC_000004.12","chrstart":73740568,"chrstop":73743715},{"annotationrelease":"RS_2024_08","assemblyaccver":"GCF_009914755.1","chraccver":"NC_060928.1","chrstart":77084333,"chrstop":77087479},{"annotationrelease":"RS_2023_10","assemblyaccver":"GCF_000001405.40","chraccver":"NC_000004.12","chrstart":73740568,"chrstop":73743715},{"annotationrelease":"RS_2023_10","assemblyaccver":"GCF_009914755.1","chraccver":"NC_060928.1","chrstart":77084333,"chrstop":77087479},{"annotationrelease":"RS_2023_03","assemblyaccver":"GCF_000001405.40","chraccver":"NC_000004.12","chrstart":73740568,"chrstop":73743715},{"annotationrelease":"RS_2023_03","assemblyaccver":"GCF_009914755.1","chraccver":"NC_060928.1","chrstart":77084333,"chrstop":77087479},{"annotationrelease":"110","assemblyaccver":"GCF_000001405.40","chraccver":"NC_000004.12","chrstart":73740568,"chrstop":73743715},{"annotationrelease":"110","assemblyaccver":"GCF_009914755.1","chraccver":"NC_060928.1","chrstart":77084333,"chrstop":77087479},{"annotationrelease":"109.20211119","assemblyaccver":"GCF_000001405.39","chraccver":"NC_000004.12","chrstart":73740568,"chrstop":73743715},{"annotationrelease":"RS_2024_09","assemblyaccver":"GCF_000001405.25","chraccver":"NC_000004.11","chrstart":74606285,"chrstop":74609432},{"annotationrelease":"105.20220307","assemblyaccver":"GCF_000001405.25","chraccver":"NC_000004.11","chrstart":74606285,"chrstop":746